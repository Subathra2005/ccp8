{
  "name": "automated-answer-evaluator",
  "version": "1.0.0",
  "description": "AI powered handwritten answer sheet evaluator",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
